package components

import (
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/viewmodel"
)

// PostBodyは、誰かが投稿に書いたものを描画します。書かれたままのテキストと、その
// 中のレス参照とアドレスを、それが置かれた場所でリンクに変えたものです。
//
// ここに書き手が与えたマークアップはありません。本文は打たれたままの平文として保存され、
// 断片へ分解された状態で届く (viewmodel.NewPostBody) ため、どの断片もtemplのエスケープ
// を通り、タグのように読める本文はそのテキストとして表示されて解釈されません。分解を
// ここでHTMLの文字列として行わない理由がこれです。
//
// 改行もまた書き手のものであるため、テキストはそれを保ったまま、その内側で折り返します。
// 途切れない長い連なり (空白を含まないアドレスがその代表です) は、ページより広くカラムを
// 押し広げるのではなく分割します。
//
// 参照は同じページの中の名指された投稿へ、アドレスはそれが指す先へ繋がります。アドレスは
// 書かれたままに表示します。それが行き先の説明として書き手が差し出したものであり、ラベルへ
// 書き換えることは、こちら側が訪れていない行き先について述べることになるためです。本文
// から外へ出るリンクには、コミュニティではなく訪問者が書いたものである印を付けます。
// コミュニティの評価を、投稿するだけで誰もが持ち出せるものにしないためです。
templ PostBody(body viewmodel.PostBody) {
	<div class="whitespace-pre-wrap wrap-break-word">
		for _, token := range body.Tokens {
			switch token.Kind {
				case viewmodel.PostBodyPostReference:
					<a href={ templates.PostAnchor(token.Number).SafeURL() } class="underline underline-offset-2">{ token.Text }</a>
				case viewmodel.PostBodyURL:
					<a href={ token.Text } rel="nofollow ugc" class="underline underline-offset-2">{ token.Text }</a>
				default:
					{ token.Text }
			}
		}
	</div>
}
