package components

import "github.com/groobb/groobb/go/internal/templates"

// Headerはサインイン済みページが共有するナビゲーションを描画します。ホームへ
// 戻る導線を持ち、これがサインイン済みページを行き止まりにしないためのものです。
// 認証の背後のページは、これが無いとブラウザの戻る操作でしか出られません。サイト
// 全体のナビゲーションは、それが行き来する対象のページができてから決まるものなので、
// それまではこの1本のリンクだけを持ちます。
//
// <nav> にラベルを付けるのは、設定ハブがページ内容にもう1つ <nav> を描画するため
// です。支援技術が2つのナビゲーション領域を区別できるのはこのラベルによります。
// ホームページ自身ではリンクにaria-current="page" を付け、リンクに辿り着いた読者に、
// そこが行き先ではなく既にいる場所を指していることを伝えます。
templ Header() {
	<header class="border-b border-border">
		<nav
			class="mx-auto flex w-full max-w-md items-center px-4 py-3"
			aria-label={ templates.T(ctx, "header_nav_label") }
		>
			<a
				href={ templates.HomePath().SafeURL() }
				class="font-semibold tracking-tight"
				if templates.IsCurrentPath(ctx, templates.HomePath().String()) {
					aria-current="page"
				}
			>
				{ templates.T(ctx, "header_home_link") }
			</a>
		</nav>
	</header>
}
