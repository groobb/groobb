package components

import (
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/viewmodel"
)

// ThreadLockNoticeは、スレッドがこれ以上の投稿を受け付けない理由を、1つの理由に
// つき1文で描画します。ロックされていないスレッドには何も描画しないため、呼び出し側は
// 返信フォームが置かれるはずの場所に無条件で置けます。
//
// すべての理由をまとめた1文ではなく理由ごとに文を書くのは、理由が1つのメッセージの
// 変種ではないためです。それぞれが述べることは異なり、次に向かう先を差し出す理由もあれば
// そうでない理由もあります。スレッドが持つ理由のうちどれを述べるかはStatedReasonsが
// 答えます。
//
// 文の下には、呼び出し側が次のスレッドを名指し、案内がそれを差し出せるときに、そこへ向かう
// 道が立ちます。満杯になったスレッドは、まだ終わっていないかもしれない会話を終わらせて
// おり、これが無ければ訪問者は、ここには書けないということだけを告げられます。
//
// 自身の文を持たない理由は何も描きません。アプリケーションが持つ理由はいずれもその文言と
// 共に追加されるため、これはページが出会うことを想定した場合ではなく、文言を伴わずに
// 導入された理由が置かれる状態です。
templ ThreadLockNotice(data ThreadLockNoticeData) {
	if data.Lock.Locked() {
		<div class="flex flex-col gap-3">
			for _, reason := range data.StatedReasons() {
				switch reason {
					case viewmodel.ThreadLockReasonLockedByModerator:
						@threadLockSentence(data.Refusal) {
							{ templates.T(ctx, "thread_lock_locked_by_moderator") }
						}
					case viewmodel.ThreadLockReasonPostLimitReached:
						@threadLockSentence(data.Refusal) {
							{ templates.T(ctx, "thread_lock_post_limit_reached", map[string]any{"Limit": data.PostLimit}) }
						}
				}
			}
			if path := data.NextThreadPath(); path != "" {
				<a href={ path.SafeURL() } class="btn self-start" data-variant="outline">
					{ templates.T(ctx, "thread_lock_next_thread_link") }
				</a>
			}
		</div>
	}
}

// threadLockSentenceは、1つの理由の文を、その場面に応じた形で包みます。送信への
// 答えであるときは到着時に読み上げられるdestructiveのアラートとし、読まれている
// スレッドの一部であるときは控えめな注記とします。
templ threadLockSentence(refusal bool) {
	if refusal {
		<div class="alert" data-variant="destructive" role="alert">
			<h2>{ children... }</h2>
		</div>
	} else {
		<p class="rounded-md border border-border bg-muted px-4 py-3 text-sm text-muted-foreground">
			{ children... }
		</p>
	}
}
