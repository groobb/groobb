package sign_in

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
)

// NewPageData is the data for the sign-in form page. Email is echoed back so a
// re-rendered form (after a validation error) keeps what the user typed, and
// FormErrors carries the validation messages: a form-wide message (an invalid
// email/password combination) shown at the top, and per-field messages (a missing
// or malformed email, a missing password) shown beneath each input. The password
// is deliberately not echoed back, since re-rendering a password field with its
// value is a credential-leak risk.
//
// [Ja] NewPageData はサインインフォームページのデータです。Email は再描画
// (バリデーションエラー後) でユーザーの入力を保つためにエコーバックし、FormErrors は
// バリデーションメッセージを運びます。上部に出すフォーム全体のメッセージ (email と
// パスワードの組み合わせが不正) と、各入力欄の下に出すフィールド別のメッセージ (email の
// 未入力・不正、パスワードの未入力) です。パスワードは意図的にエコーバックしません。値付き
// でパスワードフィールドを再描画するのは資格情報の漏えいリスクのためです。
type NewPageData struct {
	CSRFToken  string
	Email      string
	FormErrors *model.ValidationError
}

// New renders the sign-in form: an email and a password field that, on submit,
// authenticate the user and issue a session. The CSRF token is embedded as a
// hidden field for the double-submit-cookie check, and links to the password
// reset request and to sign-up are offered below the form.
//
// [Ja] New はサインインフォームを描画します。送信するとユーザーを認証しセッションを発行
// する、email とパスワードのフィールドです。CSRF トークンは double-submit cookie 検証の
// ため hidden フィールドとして埋め込み、フォームの下にパスワードリセット申請とサインアップ
// へのリンクを提供します。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight text-gray-900">
				{ templates.T(ctx, "sign_in_new_heading") }
			</h1>
			<p class="text-sm text-gray-600">
				{ templates.T(ctx, "sign_in_new_lead") }
			</p>
		</div>
		<form action="/sign_in" method="POST" class="flex flex-col gap-4">
			if data.FormErrors.HasGlobalError() {
				<div role="alert" class="rounded-md border border-red-300 bg-red-50 px-3 py-2">
					for _, message := range data.FormErrors.GetGlobalErrors() {
						<p class="text-sm text-red-600">{ message }</p>
					}
				</div>
			}
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="flex flex-col gap-1">
				<label for="email" class="text-sm font-medium text-gray-900">
					{ templates.T(ctx, "sign_in_new_email_label") }
				</label>
				<input
					id="email"
					name="email"
					type="email"
					value={ data.Email }
					autocomplete="email"
					required
					autofocus
					if data.FormErrors.HasFieldError("email") {
						aria-invalid="true"
						aria-describedby="email-error"
					}
					class="rounded-md border border-gray-300 px-3 py-2"
				/>
				if data.FormErrors.HasFieldError("email") {
					<div id="email-error" role="alert" class="flex flex-col gap-1">
						for _, message := range data.FormErrors.GetFieldErrors("email") {
							<p class="text-sm text-red-600">{ message }</p>
						}
					</div>
				}
			</div>
			<div class="flex flex-col gap-1">
				<label for="password" class="text-sm font-medium text-gray-900">
					{ templates.T(ctx, "sign_in_new_password_label") }
				</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					enterkeyhint="go"
					required
					if data.FormErrors.HasFieldError("password") {
						aria-invalid="true"
						aria-describedby="password-error"
					}
					class="rounded-md border border-gray-300 px-3 py-2"
				/>
				if data.FormErrors.HasFieldError("password") {
					<div id="password-error" role="alert" class="flex flex-col gap-1">
						for _, message := range data.FormErrors.GetFieldErrors("password") {
							<p class="text-sm text-red-600">{ message }</p>
						}
					</div>
				}
			</div>
			<button type="submit" class="rounded-full bg-gray-900 px-4 py-2 font-medium text-white">
				{ templates.T(ctx, "sign_in_new_submit") }
			</button>
		</form>
		<p class="text-center text-sm text-gray-600">
			<a href="/password_reset/new" class="font-medium text-gray-900 underline">
				{ templates.T(ctx, "sign_in_new_forgot_password_link") }
			</a>
		</p>
		<p class="text-center text-sm text-gray-600">
			<a href="/sign_up" class="font-medium text-gray-900 underline">
				{ templates.T(ctx, "sign_in_new_sign_up_link") }
			</a>
		</p>
	</div>
}
