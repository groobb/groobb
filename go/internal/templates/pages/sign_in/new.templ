package sign_in

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// NewPageData is the data for the sign-in form page. Email is echoed back so a
// re-rendered form (after a validation error) keeps what the user typed, and
// FormErrors carries the validation messages: a form-wide message (an invalid
// email/password combination, or a failed bot check) shown at the top, and
// per-field messages (a missing or malformed email, a missing password) shown
// beneath each input. The password is deliberately not echoed back, since
// re-rendering a password field with its value is a credential-leak risk.
// TurnstileSiteKey renders the bot-protection widget; when it is empty (the
// disabled dev / test setup) the widget is omitted entirely.
//
// [Ja] NewPageData はサインインフォームページのデータです。Email は再描画
// (バリデーションエラー後) でユーザーの入力を保つためにエコーバックし、FormErrors は
// バリデーションメッセージを運びます。上部に出すフォーム全体のメッセージ (email と
// パスワードの組み合わせが不正、または Bot 検証の失敗) と、各入力欄の下に出すフィールド別の
// メッセージ (email の未入力・不正、パスワードの未入力) です。パスワードは意図的に
// エコーバックしません。値付きでパスワードフィールドを再描画するのは資格情報の漏えいリスクの
// ためです。TurnstileSiteKey は Bot 対策ウィジェットを描画します。空のとき (無効化された
// dev / test 構成) はウィジェットを完全に省きます。
type NewPageData struct {
	CSRFToken        string
	Email            string
	FormErrors       *model.ValidationError
	TurnstileSiteKey string
}

// New renders the sign-in form: an email and a password field that, on submit,
// authenticate the user and issue a session. The CSRF token is embedded as a
// hidden field for the double-submit-cookie check, and links to the password
// reset request and to sign-up are offered below the form.
//
// [Ja] New はサインインフォームを描画します。送信するとユーザーを認証しセッションを発行
// する、email とパスワードのフィールドです。CSRF トークンは double-submit cookie 検証の
// ため hidden フィールドとして埋め込み、フォームの下にパスワードリセット申請とサインアップ
// へのリンクを提供します。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "sign_in_new_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "sign_in_new_lead") }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form action="/sign_in" method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("email") {
					data-invalid="true"
				}
			>
				<label for="email">
					{ templates.T(ctx, "sign_in_new_email_label") }
				</label>
				<input
					id="email"
					name="email"
					type="email"
					value={ data.Email }
					autocomplete="email"
					required
					autofocus
					if data.FormErrors.HasFieldError("email") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("email", data.FormErrors) }
					}
				/>
				@components.FieldErrors("email", data.FormErrors)
			</div>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password") {
					data-invalid="true"
				}
			>
				<label for="password">
					{ templates.T(ctx, "sign_in_new_password_label") }
				</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					enterkeyhint="go"
					required
					if data.FormErrors.HasFieldError("password") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("password", data.FormErrors) }
					}
				/>
				@components.FieldErrors("password", data.FormErrors)
			</div>
			@components.Turnstile(data.TurnstileSiteKey)
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "sign_in_new_submit") }
			</button>
		</form>
		<p class="text-center text-sm text-muted-foreground">
			<a href="/password_reset/new" class="font-medium text-foreground underline underline-offset-4">
				{ templates.T(ctx, "sign_in_new_forgot_password_link") }
			</a>
		</p>
		<p class="text-center text-sm text-muted-foreground">
			<a href="/sign_up" class="font-medium text-foreground underline underline-offset-4">
				{ templates.T(ctx, "sign_in_new_sign_up_link") }
			</a>
		</p>
	</div>
}
