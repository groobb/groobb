package sign_in

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// NewPageDataはサインインフォームページのデータです。Emailは再描画
// (バリデーションエラー後) でユーザーの入力を保つためにエコーバックし、FormErrorsは
// バリデーションメッセージを運びます。上部に出すフォーム全体のメッセージ (emailと
// パスワードの組み合わせが不正、またはBot検証の失敗) と、各入力欄の下に出すフィールド別の
// メッセージ (emailの未入力・不正、パスワードの未入力) です。パスワードは意図的に
// エコーバックしません。値付きでパスワードフィールドを再描画するのは資格情報の漏えいリスクの
// ためです。TurnstileSiteKeyはBot対策ウィジェットを描画します。空のとき (無効化された
// dev / test構成) はウィジェットを完全に省きます。ReturnToは保護されたルートに追い返された
// とき訪問者が向かっていた先を運び、そこへ着地させられるよう資格情報と一緒に送信します。
type NewPageData struct {
	CSRFToken        string
	Email            string
	FormErrors       *model.ValidationError
	TurnstileSiteKey string
	ReturnTo         string
}

// Newはサインインフォームを描画します。送信するとユーザーを認証しセッションを発行
// する、emailとパスワードのフィールドです。CSRFトークンはdouble-submit cookie検証の
// ためhiddenフィールドとして埋め込み、フォームの下にパスワードリセット申請とサインアップ
// へのリンクを提供します。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "sign_in_new_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "sign_in_new_lead") }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form action={ templates.SignInPath().SafeURL() } method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			if data.ReturnTo != "" {
				<input type="hidden" name={ templates.ReturnToParam } value={ data.ReturnTo }/>
			}
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("email") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("email", templates.T(ctx, "sign_in_new_email_label"))
				<input
					id="email"
					name="email"
					type="email"
					value={ data.Email }
					autocomplete="email"
					required
					autofocus
					if data.FormErrors.HasFieldError("email") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("email", data.FormErrors) }
					}
				/>
				@components.FieldErrors("email", data.FormErrors)
			</div>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("password", templates.T(ctx, "sign_in_new_password_label"))
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					enterkeyhint="go"
					required
					if data.FormErrors.HasFieldError("password") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("password", data.FormErrors) }
					}
				/>
				@components.FieldErrors("password", data.FormErrors)
			</div>
			@components.Turnstile(data.TurnstileSiteKey)
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "sign_in_new_submit") }
			</button>
		</form>
		<p class="text-center text-sm text-muted-foreground">
			<a href="/password_reset/new" class="font-medium text-foreground underline underline-offset-4">
				{ templates.T(ctx, "sign_in_new_forgot_password_link") }
			</a>
		</p>
		<p class="text-center text-sm text-muted-foreground">
			<a href={ templates.SignUpPath().SafeURL() } class="font-medium text-foreground underline underline-offset-4">
				{ templates.T(ctx, "sign_in_new_sign_up_link") }
			</a>
		</p>
	</div>
}
