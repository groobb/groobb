package password_reset

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
)

// NewPageData is the data for the password reset request form page. Email is
// echoed back so a re-rendered form (after a validation error) keeps what the
// user typed, and FormErrors carries the per-field validation messages to show.
//
// [Ja] NewPageData はパスワードリセット申請フォームページのデータです。Email は再描画
// (バリデーションエラー後) でユーザーの入力を保つためにエコーバックし、FormErrors は
// 表示するフィールド別のバリデーションメッセージを運びます。
type NewPageData struct {
	CSRFToken  string
	Email      string
	FormErrors *model.ValidationError
}

// New renders the password reset request form: a single email field that, on
// submit, requests a reset link. The CSRF token is embedded as a hidden field for
// the double-submit-cookie check, and a link back to sign-in is offered.
//
// [Ja] New はパスワードリセット申請フォームを描画します。送信するとリセットリンクを
// 要求する単一の email フィールドです。CSRF トークンは double-submit cookie 検証のため
// hidden フィールドとして埋め込み、サインインへ戻るリンクを提供します。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight text-gray-900">
				{ templates.T(ctx, "password_reset_new_heading") }
			</h1>
			<p class="text-sm text-gray-600">
				{ templates.T(ctx, "password_reset_new_lead") }
			</p>
		</div>
		<form action="/password_reset" method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="flex flex-col gap-1">
				<label for="email" class="text-sm font-medium text-gray-900">
					{ templates.T(ctx, "password_reset_new_email_label") }
				</label>
				<input
					id="email"
					name="email"
					type="email"
					value={ data.Email }
					autocomplete="email"
					enterkeyhint="send"
					required
					autofocus
					if data.FormErrors.HasFieldError("email") {
						aria-invalid="true"
						aria-describedby="email-error"
					}
					class="rounded-md border border-gray-300 px-3 py-2"
				/>
				if data.FormErrors.HasFieldError("email") {
					<div id="email-error" role="alert" class="flex flex-col gap-1">
						for _, message := range data.FormErrors.GetFieldErrors("email") {
							<p class="text-sm text-red-600">{ message }</p>
						}
					</div>
				}
			</div>
			<button type="submit" class="rounded-full bg-gray-900 px-4 py-2 font-medium text-white">
				{ templates.T(ctx, "password_reset_new_submit") }
			</button>
		</form>
		<p class="text-center text-sm text-gray-600">
			<a href="/sign_in" class="font-medium text-gray-900 underline">
				{ templates.T(ctx, "password_reset_new_back_to_sign_in") }
			</a>
		</p>
	</div>
}
