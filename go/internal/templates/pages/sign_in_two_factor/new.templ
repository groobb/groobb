package sign_in_two_factor

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// NewPageDataはサインイン時のTOTPチャレンジページのデータです。Codeは再描画
// (バリデーションエラー後) でユーザーの入力を保つためにエコーバックし、FormErrorsは
// バリデーションメッセージを運びます。上部に出すフォーム全体のメッセージ (失われたチャレンジ
// で再サインインを促すもの) と、入力欄の下に出すフィールド別のメッセージ (コードの形式エラー・
// 不一致) です。ReturnToは保護されたルートに追い返されたとき訪問者が向かっていた先を運び、
// パスワードのステップから引き渡され、このフォームとリカバリーコードへのリンクを通じてさらに
// 引き継がれます。
type NewPageData struct {
	CSRFToken  string
	Code       string
	FormErrors *model.ValidationError
	ReturnTo   string
}

// Newはサインイン時のTOTPチャレンジフォームを描画します。送信すると保留中ユーザーの
// 認証アプリのコードを検証しサインインを完了させる単一の6桁codeフィールドです。フォームは
// /sign_in/two_factorへPOSTし、CSRFトークンはdouble-submit cookie検証のためhidden
// フィールドとして埋め込みます。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "sign_in_two_factor_new_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "sign_in_two_factor_new_lead") }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form action={ templates.SignInTwoFactorPath().SafeURL() } method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			if data.ReturnTo != "" {
				<input type="hidden" name={ templates.ReturnToParam } value={ data.ReturnTo }/>
			}
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("code") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("code", templates.T(ctx, "sign_in_two_factor_new_code_label"))
				<input
					id="code"
					name="code"
					type="text"
					value={ data.Code }
					inputmode="numeric"
					autocomplete="one-time-code"
					pattern="[0-9]{6}"
					maxlength="6"
					enterkeyhint="go"
					required
					autofocus
					if data.FormErrors.HasFieldError("code") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("code", data.FormErrors) }
					}
				/>
				@components.FieldErrors("code", data.FormErrors)
			</div>
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "sign_in_two_factor_new_submit") }
			</button>
		</form>
		<p class="text-center text-sm">
			<a href={ templates.SignInTwoFactorRecoveryNewPath().WithReturnTo(data.ReturnTo).SafeURL() } class="underline">
				{ templates.T(ctx, "sign_in_two_factor_new_use_recovery_link") }
			</a>
		</p>
	</div>
}
