package password

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// EditPageDataはパスワードリセット更新 (新パスワード) ページのデータです。Tokenは
// 平文のリセットトークンで、送信フォームがどのトークンを消費するか示すようhidden
// フィールドで運びます。トークンエラー時はハンドラーが消去し、無効なリンクが再送信され
// ないようにします。FormErrorsはメッセージを運びます。上部に出すフォーム全体のメッセージ
// (リンクが無効・使用済み・期限切れ) と、各フィールドの下に出すフィールド別のメッセージ
// (短すぎ・長すぎ・不一致のパスワード) です。パスワードの値は意図的にエコーバックしません。
// 値付きでパスワードフィールドを再描画するのは資格情報の漏えいリスクのためです。
type EditPageData struct {
	CSRFToken  string
	Token      string
	FormErrors *model.ValidationError
}

// Editは新パスワードフォームを描画します。送信するとアカウントの新しいパスワードを
// 設定しリセットトークンを消費する、パスワードとパスワード確認のフィールドです。フォームは
// hiddenな _method=PATCHを付けて /passwordへPOSTし、HTMLフォームからPATCHルートを
// 動かします。CSRFトークンとリセットトークンはhiddenフィールドとして埋め込みます。
// 現在のリンクがもう有効でないときのために、新しいリセットリンクを申請するリンクを下に
// 提供します。
templ Edit(data EditPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "password_edit_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "password_edit_lead") }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form action="/password" method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="_method" value="PATCH"/>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<input type="hidden" name="token" value={ data.Token }/>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("password", templates.T(ctx, "password_edit_password_label"))
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="new-password"
					minlength="8"
					required
					autofocus
					if data.FormErrors.HasFieldError("password") {
						aria-invalid="true"
						aria-describedby={ "password-hint " + components.FieldErrorsDescribedBy("password", data.FormErrors) }
					} else {
						aria-describedby="password-hint"
					}
				/>
				<p id="password-hint">{ templates.T(ctx, "password_edit_password_hint") }</p>
				@components.FieldErrors("password", data.FormErrors)
			</div>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password_confirmation") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("password_confirmation", templates.T(ctx, "password_edit_password_confirmation_label"))
				<input
					id="password_confirmation"
					name="password_confirmation"
					type="password"
					autocomplete="new-password"
					minlength="8"
					enterkeyhint="send"
					required
					if data.FormErrors.HasFieldError("password_confirmation") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("password_confirmation", data.FormErrors) }
					}
				/>
				@components.FieldErrors("password_confirmation", data.FormErrors)
			</div>
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "password_edit_submit") }
			</button>
		</form>
		<p class="text-center text-sm text-muted-foreground">
			<a href="/password_reset/new" class="font-medium text-foreground underline underline-offset-4">
				{ templates.T(ctx, "password_edit_request_new_link") }
			</a>
		</p>
	</div>
}
