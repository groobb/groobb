package welcome

import "github.com/groobb/groobb/go/internal/templates"

// ShowはGroobbのトップページを描画します。中央寄せのカードにサービスの
// 見出しと短い説明、そしてサインアップとサインインへ誘導する2つのCTAを表示します。
// 文言はロケールファイルから取得し、リクエストのロケールに従います。
templ Show() {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="card text-center">
			<header>
				<h1 class="card-title">{ templates.T(ctx, "welcome_show_heading") }</h1>
				<p>{ templates.T(ctx, "welcome_show_lead") }</p>
			</header>
			<footer class="flex-col gap-2">
				<a href={ templates.SignUpPath().SafeURL() } class="btn w-full">
					{ templates.T(ctx, "welcome_show_sign_up_link") }
				</a>
				<a href={ templates.SignInPath().SafeURL() } class="btn w-full" data-variant="outline">
					{ templates.T(ctx, "welcome_show_sign_in_link") }
				</a>
			</footer>
		</div>
	</div>
}
