package thread_lock

import (
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// New renders the page a thread's lock is confirmed on: what locking does, the
// thread it is about to be done to, an optional note, and the button that does
// it.
//
// The thread is not chosen here. It is named by the address the form submits
// to, so the page can only close the thread it was opened from, and it states
// which one that is instead of offering a choice that is already made.
//
// The note is optional and its label says so. What the history has to carry is
// the operation, which it carries either way, and a required note is answered
// by a full stop as readily as by a reason. The hint says where the note goes,
// because an administrator writing it has to know whether the thread's readers
// will see it: they will not.
//
// A cancel link stands beside the button, since arriving here is one click from
// the thread and leaving should be one click back. The link is the way out of a
// destructive confirmation, so it is not styled as a second thing to press.
//
// [Ja] Newは、スレッドのロックを確認するページを描画します。ロックが何をするのか、これから
// それが行われるスレッド、任意の注記、そしてそれを行うボタンです。
//
// スレッドはここで選びません。フォームの送信先のアドレスが名指すため、このページは自身が
// 開かれたスレッドしか閉じられず、既に決まっている選択を差し出すのではなく、どのスレッドで
// あるかを述べます。
//
// 注記は任意であり、ラベルがそのことを述べます。履歴が運ばなければならないのは操作そのもの
// であり、それはどちらの場合も運ばれます。必須にしても、理由と同じ手軽さで句点ひとつが返って
// くるだけです。ヒントが注記の行き先を述べるのは、それを書く管理者が、スレッドの読み手に
// それが見えるかどうかを知っていなければならないためです。見えません。
//
// ボタンの傍らに取り消しのリンクを置きます。ここへ来るのはスレッドから1クリックであり、
// 去るのも1クリックで戻れるべきであるためです。リンクは破壊的な確認からの出口であり、押す
// べき2つ目のものとしては装いません。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-xl flex-1 flex-col gap-6 px-4 py-12">
		<div class="flex flex-col gap-2">
			<h1 class="text-2xl font-bold tracking-tight">
				{ templates.T(ctx, "thread_lock_new_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "thread_lock_new_lead") }
			</p>
		</div>
		<div class="flex flex-col gap-1 rounded-md border border-border bg-muted px-4 py-3">
			<p class="text-xs text-muted-foreground">
				{ templates.T(ctx, "thread_lock_new_target_label") }
			</p>
			<p
				class="font-medium wrap-anywhere"
				if data.Language.Declared() {
					lang={ data.Language.Tag }
				}
			>
				{ data.Title }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form
			action={ templates.ThreadLockPath(data.ThreadID).SafeURL() }
			method="POST"
			class="flex flex-col gap-4"
		>
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("reason") {
					data-invalid="true"
				}
			>
				<label for="reason">{ templates.T(ctx, "thread_lock_new_reason_label") }</label>
				<textarea
					id="reason"
					name="reason"
					rows="4"
					autofocus
					if data.FormErrors.HasFieldError("reason") {
						aria-invalid="true"
						aria-describedby={ "reason-hint " + components.FieldErrorsDescribedBy("reason", data.FormErrors) }
					} else {
						aria-describedby="reason-hint"
					}
				>{ "\n" + data.Reason }</textarea>
				<p id="reason-hint">{ templates.T(ctx, "thread_lock_new_reason_hint") }</p>
				@components.FieldErrors("reason", data.FormErrors)
			</div>
			<div class="flex flex-wrap items-center gap-4">
				<button type="submit" class="btn" data-variant="destructive">
					{ templates.T(ctx, "thread_lock_new_submit_button") }
				</button>
				<a href={ templates.ThreadPath(data.ThreadID).SafeURL() } class="text-sm underline">
					{ templates.T(ctx, "thread_lock_new_cancel") }
				</a>
			</div>
		</form>
	</div>
}
