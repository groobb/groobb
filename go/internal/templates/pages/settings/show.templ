package settings

import "github.com/groobb/groobb/go/internal/templates"

// Showは設定ハブを描画します。見出しと、各設定画面 (メールアドレス変更・2段階認証・
// 退会) へのリンクの一覧です。後から設定項目を兄弟リンクとして追加できるようリンクの一覧
// として作ります。退会リンクは兄弟と同じスタイルの素朴なナビゲーションリンクで、destructive
// のバリアントは退会ページ側の実際の削除submitのために予約します。フォームが無いため
// CSRFトークンは不要です。
templ Show() {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 id="settings-show-heading" class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "settings_show_heading") }
			</h1>
		</div>
		<nav aria-labelledby="settings-show-heading" class="flex flex-col gap-2">
			<a href={ templates.SettingsEmailEditPath().SafeURL() } class="btn w-full" data-variant="outline">
				{ templates.T(ctx, "settings_show_email_change_link") }
			</a>
			<a href={ templates.SettingsTwoFactorAuthNewPath().SafeURL() } class="btn w-full" data-variant="outline">
				{ templates.T(ctx, "settings_show_two_factor_auth_link") }
			</a>
			<a href={ templates.SettingsWithdrawalNewPath().SafeURL() } class="btn w-full" data-variant="outline">
				{ templates.T(ctx, "settings_show_withdrawal_link") }
			</a>
		</nav>
	</div>
}
