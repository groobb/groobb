package errors

import "github.com/groobb/groobb/go/internal/templates"

// Unpublishedは、管理者が見えない場所へ移したアドレスに応答するページの本文を
// 描画します。ここに立っていたものが取り除かれたことを示し、訪問者を行き止まりに
// 残さないようトップページへのリンクを置きます。
//
// ページが存在しないことではなくスレッドが取り下げられたことを述べるのは、そのアドレスが
// コミュニティの持っていたものであり、訪問者がまだ応答していた頃に共有されたリンクから
// 辿り着いたのかもしれないためです。素の404は、辿ったリンクが打ち間違いだったのかどうかを
// 考えさせることになります。
//
// 誰がなぜ取り除いたのかは述べません。理由は管理者が読む操作履歴へ渡ります。スレッドを
// 読んでいる訪問者に伝えるのはそれに何が起きたかであって、誰かの投稿について何が判断されたか
// ではありません。
//
// リンク先をトップページにするのはNotFoundと同じ理由です。このページは誰が尋ねているかを
// 解決せずに描画され、トップページはサインイン済みの訪問者を自分でホームへ引き渡します。
templ Unpublished() {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="card text-center">
			<header>
				<h1 class="card-title">{ templates.T(ctx, "error_unpublished_heading") }</h1>
				<p>{ templates.T(ctx, "error_unpublished_message") }</p>
			</header>
			<footer>
				<a href={ templates.RootPath().SafeURL() } class="btn w-full">
					{ templates.T(ctx, "error_unpublished_back_to_home") }
				</a>
			</footer>
		</div>
	</div>
}
