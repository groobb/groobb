package account

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
)

// NewPageDataはアカウント作成ページのデータです。Atnameは送信された @ハンドルで、
// バリデーションエラー時にエコーバックしてユーザーが打ち直さずに済むようにします (資格情報
// ではないため)。FormErrorsはフィールド別のバリデーションメッセージを運び、不正なatnameや
// 短すぎ・長すぎ・不一致のパスワードは該当フィールドの下に表示します。パスワードの値は
// 意図的にエコーバックしません。値付きでパスワードフィールドを再描画するのは資格情報の
// 漏えいリスクのため、バリデーションエラー時はユーザーに再入力させます。
type NewPageData struct {
	CSRFToken  string
	Atname     string
	FormErrors *model.ValidationError
}

// Newはアカウント作成フォームを描画します。送信すると (検証済みの確認のemailを
// 使って) アカウントを作成しユーザーをサインインさせる、パスワードとパスワード確認の
// フィールドです。CSRFトークンはdouble-submit cookie検証のためhiddenフィールドとして
// 埋め込みます。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight">
				{ templates.T(ctx, "account_new_heading") }
			</h1>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "account_new_lead") }
			</p>
		</div>
		@components.FormErrors(data.FormErrors)
		<form action="/account" method="POST" class="flex flex-col gap-4">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("atname") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("atname", templates.T(ctx, "account_new_atname_label"))
				<input
					id="atname"
					name="atname"
					type="text"
					autocomplete="username"
					autocapitalize="none"
					spellcheck="false"
					maxlength="20"
					pattern="[A-Za-z0-9_]+"
					required
					autofocus
					value={ data.Atname }
					if data.FormErrors.HasFieldError("atname") {
						aria-invalid="true"
						aria-describedby={ "atname-hint " + components.FieldErrorsDescribedBy("atname", data.FormErrors) }
					} else {
						aria-describedby="atname-hint"
					}
				/>
				<p id="atname-hint">{ templates.T(ctx, "account_new_atname_hint") }</p>
				@components.FieldErrors("atname", data.FormErrors)
			</div>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("password", templates.T(ctx, "account_new_password_label"))
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="new-password"
					minlength="8"
					required
					if data.FormErrors.HasFieldError("password") {
						aria-invalid="true"
						aria-describedby={ "password-hint " + components.FieldErrorsDescribedBy("password", data.FormErrors) }
					} else {
						aria-describedby="password-hint"
					}
				/>
				<p id="password-hint">{ templates.T(ctx, "account_new_password_hint") }</p>
				@components.FieldErrors("password", data.FormErrors)
			</div>
			<div
				role="group"
				class="field"
				if data.FormErrors.HasFieldError("password_confirmation") {
					data-invalid="true"
				}
			>
				@components.RequiredFieldLabel("password_confirmation", templates.T(ctx, "account_new_password_confirmation_label"))
				<input
					id="password_confirmation"
					name="password_confirmation"
					type="password"
					autocomplete="new-password"
					minlength="8"
					enterkeyhint="send"
					required
					if data.FormErrors.HasFieldError("password_confirmation") {
						aria-invalid="true"
						aria-describedby={ components.FieldErrorsDescribedBy("password_confirmation", data.FormErrors) }
					}
				/>
				@components.FieldErrors("password_confirmation", data.FormErrors)
			</div>
			<button type="submit" class="btn w-full">
				{ templates.T(ctx, "account_new_submit") }
			</button>
		</form>
	</div>
}
