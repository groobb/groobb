package email_confirmation

import (
	"github.com/groobb/groobb/go/internal/model"
	"github.com/groobb/groobb/go/internal/templates"
)

// NewPageData is the data for the confirmation-code entry page. Code is echoed
// back so a re-rendered form (after a validation error) keeps what the user
// typed, and FormErrors carries the validation messages: a form-wide message
// (an incorrect or expired code) shown at the top, and a per-field message (a
// malformed code) shown beneath the input.
//
// [Ja] NewPageData は確認コード入力ページのデータです。Code は再描画 (バリデーション
// エラー後) でユーザーの入力を保つためにエコーバックし、FormErrors はバリデーション
// メッセージを運びます。上部に出すフォーム全体のメッセージ (コードが不正または期限切れ)
// と、入力欄の下に出すフィールド別のメッセージ (コードの形式エラー) です。
type NewPageData struct {
	CSRFToken  string
	Code       string
	FormErrors *model.ValidationError
}

// New renders the confirmation-code entry form: a single six-digit code field
// that, on submit, verifies the code emailed during sign-up. The CSRF token is
// embedded as a hidden field for the double-submit-cookie check.
//
// [Ja] New は確認コード入力フォームを描画します。送信するとサインアップ時にメール送信
// した 6 桁のコードを検証する単一の code フィールドです。CSRF トークンは double-submit
// cookie 検証のため hidden フィールドとして埋め込みます。
templ New(data NewPageData) {
	<div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center gap-6 px-4 py-16">
		<div class="flex flex-col gap-2 text-center">
			<h1 class="text-3xl font-bold tracking-tight text-gray-900">
				{ templates.T(ctx, "email_confirmation_new_heading") }
			</h1>
			<p class="text-sm text-gray-600">
				{ templates.T(ctx, "email_confirmation_new_lead") }
			</p>
		</div>
		<form action="/email_confirmation" method="POST" class="flex flex-col gap-4">
			if data.FormErrors.HasGlobalError() {
				<div role="alert" class="rounded-md border border-red-300 bg-red-50 px-3 py-2">
					for _, message := range data.FormErrors.GetGlobalErrors() {
						<p class="text-sm text-red-600">{ message }</p>
					}
				</div>
			}
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
			<div class="flex flex-col gap-1">
				<label for="code" class="text-sm font-medium text-gray-900">
					{ templates.T(ctx, "email_confirmation_new_code_label") }
				</label>
				<input
					id="code"
					name="code"
					type="text"
					value={ data.Code }
					inputmode="numeric"
					autocomplete="one-time-code"
					pattern="[0-9]{6}"
					maxlength="6"
					enterkeyhint="send"
					required
					autofocus
					if data.FormErrors.HasFieldError("code") {
						aria-invalid="true"
						aria-describedby="code-error"
					}
					class="rounded-md border border-gray-300 px-3 py-2"
				/>
				if data.FormErrors.HasFieldError("code") {
					<div id="code-error" role="alert" class="flex flex-col gap-1">
						for _, message := range data.FormErrors.GetFieldErrors("code") {
							<p class="text-sm text-red-600">{ message }</p>
						}
					</div>
				}
			</div>
			<button type="submit" class="rounded-full bg-gray-900 px-4 py-2 font-medium text-white">
				{ templates.T(ctx, "email_confirmation_new_submit") }
			</button>
		</form>
	</div>
}
