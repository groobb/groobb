package thread

import (
	"strconv"
	"time"

	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
	"github.com/groobb/groobb/go/internal/viewmodel"
)

// ShowPageDataはスレッドページのデータです。スレッドとその投稿、在り処を示す経路、
// そしてそれが立った掲示板と、そこに立っている他のスレッドを持ちます。
//
// 掲示板のスレッドが伴うのは、このページの一覧カラムがその掲示板の一覧だからです。
// 1つのスレッドを読んでいる訪問者は次のスレッドまで1歩の距離にあり、これが無ければ
// スレッドを離れるにはまず /b/{slug} へ戻ることになります。
type ShowPageData struct {
	// ThreadIDは、このページがどのスレッドであるかを名指します。それに対して働きかける
	// 操作が名指すのがこれです。投稿はここからフラグメントで届くためidを要しませんが、操作は
	// /t/{id} の下の別のアドレスであり、idが無ければ書けません。
	ThreadID viewmodel.ThreadID

	Title string

	// Languageはこのスレッドが書かれている言語で、見出しの傍らにバッジとして
	// 見せ、見出し自身に宣言します。下に並ぶ投稿は自身の言語を持ちません。別の言語での
	// 返信も受け付けるため、スレッドの言語を本文に適用すれば、本文はそれが書かれていない
	// 言語を名乗ることになります。
	Language viewmodel.ThreadLanguage

	Breadcrumb components.BreadcrumbData
	PostsCount int
	Posts      []ShowPost
	Board      ShowBoard

	// Lockはこのスレッドがこれ以上の投稿を受け付けない理由を持ち、まだ受け付ける
	// 間は空です。スレッドの末尾で返信フォームの代わりに立つものがこれです。ロックは
	// 全員に対して成立するため、そこでサインイン済みの訪問者にもサインアウト状態の
	// 訪問者にも示されるのはこの案内です。
	Lock viewmodel.ThreadLock

	// PostLimitはスレッドが持てる投稿の数で、その上限を名指すロックの案内に
	// 差し込みます。訪問者が読む数値をアプリケーションが適用する数値と同じにするため
	// です。
	PostLimit int

	// Replyは、スレッドがまだ開いている間にその末尾に来るものです。書ける訪問者
	// にはフォームを、まだ書けない訪問者にはアカウントへの導線を持ちます。
	Reply ShowReply

	// Moderationは、このスレッドに対して働きかけることを許された訪問者に差し出される
	// ものであり、それ以外の人には空です。管理画面の背後ではなくスレッド自身のページに立つ
	// のは、何かをしなければならないと管理者が判断するとき、その人が居るのがそこだからです。
	// スレッドを読んでいるのです。
	Moderation ShowModeration
}

// ShowModerationは、スレッドのページが、それに対して働きかけてよい訪問者に差し出す
// ものです。スレッド自身への操作と、各投稿が投稿への操作を持つかどうかを表します。
//
// 権限を単一のフラグではなく操作ごとに受け取るのは、権限が1つずつ与えられるためです。
// スレッドを閉じることを許さずに投稿を隠すことだけを許すロールがありえ、その1つを持つ
// 訪問者にはその1つだけが差し出されます。
type ShowModeration struct {
	// CanLockThreadは、訪問者がこのスレッドのロックを扱ってよいことを述べます。掛ける
	// ことと外すことは1つの権限であるため (ADR 0013)、これが両方を決め、2つのうちどちらを
	// 描くかはスレッドが持つロックが決めます。
	CanLockThread bool

	CanUnpublishThread bool
	CanUnpublishPost   bool

	// CSRFTokenは、ここにある操作のうち、辿るのではなく送信する唯一のものが運びます。
	// ロックの解除は確認ページを持たないため、そのフォームはこのページに立ちます。
	CSRFToken string
}

// Shownは、スレッド自身への操作の群を描くかどうかを返します。投稿を隠すことだけを
// 許された訪問者には、ここには何も差し出されません。その人が行えることは各投稿の側に
// 立っているためです。
func (m ShowModeration) Shown() bool {
	return m.CanLockThread || m.CanUnpublishThread
}

// LockNoticeは、ロック中のスレッドについての案内を描くためのデータを返します。
// 送信への答えである旨は立てません。このページは読まれるものであり、スレッドが埋まって
// いることは、訪問者がたった今行ったことへの応答ではなく、読まれている内容の一部だから
// です。
//
// このスレッドが立った掲示板を、次にスレッドを立てる場所として名指します。訪問者が会話の
// 終わりに出会うのはこのページであり、その続きを手渡せる場所もここだからです。
func (d ShowPageData) LockNotice() components.ThreadLockNoticeData {
	return components.ThreadLockNoticeData{
		Lock:                d.Lock,
		PostLimit:           d.PostLimit,
		BoardThreadsNewPath: templates.BoardThreadsNewPath(d.Board.Slug),
	}
}

// ShowReplyは、開いているスレッドの末尾に来るものです。サインイン済みの訪問者には
// フォームを、サインアウト状態の訪問者にはこのスレッドへ連れ戻すアカウントへの導線を
// 差し出し、会話を読むことと会話に加わることを1歩の距離に置きます。
//
// スレッドがロック中のあいだは、どちらも描きません。誰からも受け付けないものは、それを
// 書くフォームにも、それを書くためのアカウントにも値しません。
type ShowReply struct {
	// SignedInは訪問者がアカウントのセッションを持っているかどうかで、フォームと
	// サインインへの誘いのどちらを出すかを決めるものです。書くことにはアカウントが要り、
	// 読むことには要りません。
	SignedIn bool

	// Formは返信フォームで、訪問者がサインインしているときにだけ埋められます。
	Form components.PostFormData

	// ReturnToはサインインが訪問者を戻す先で、それはこのスレッドです。会話の末尾
	// からサインインする人はそれに答えるためにサインインするのであり、トップページでは
	// そこをもう一度探させることになります。
	ReturnTo string
}

// ShowPostはページが描画する形の投稿1つです。レス番号・書いた人・届いた時刻・
// 述べていること・それに答えた投稿のレス番号を持ちます。
type ShowPost struct {
	Number int

	// Unpublishedは、管理者がこの投稿を見えない場所へ移したことを述べ、ページが占位を
	// 描くのはこの状態です。このとき下のフィールドは空です。印が隠すものはこの構造体へ届かず、
	// 占位が持つのは番号だけです。
	//
	// 投稿を落とさず一覧に残すのは、その番号が投稿を名指すためです。番号は1度だけ配られ、
	// 再利用されません (ADR 0009)。ページから落とした投稿は#p{number}を道連れにし、それを指す
	// すべての>>Nをどこへも繋がらないものにします。
	Unpublished bool

	// Authorは投稿を書いたアカウントのatnameで、先頭の @ を含みません。作者が
	// 退会しているときは "" です。どちらの場合も投稿は表示します。退会が外すのは書かれた
	// ものから名前であって、書かれたものではありません。
	Author string

	PostedAt time.Time
	Body     viewmodel.PostBody

	// ReplyNumbersはこの投稿を参照した投稿を、レス番号で持ちます。本文の下に
	// 描画され、>>Nのもう半分をなします。本文が前向きのリンクを運び、こちらが逆向きの
	// リンクを運びます。
	ReplyNumbers []int
}

// HasRepliesは、この投稿に答えた投稿をその下に並べるかどうかを返します。占位は何も
// 並べません。非公開の投稿への返信はその投稿が持つものから描かれますが、ページが示すものを
// それは持たないためです。
func (p ShowPost) HasReplies() bool {
	return !p.Unpublished && len(p.ReplyNumbers) > 0
}

// ShowBoardはこのスレッドが立った掲示板と、そこに立っているスレッドです。
// ページの一覧カラムが持つものがこれです。
type ShowBoard struct {
	Slug    string
	Name    string
	Threads []ShowBoardThread
}

// ShowBoardThreadは掲示板の一覧に並ぶスレッド1つで、投稿を1件も読まずに
// 1行が示すもの — タイトル・投稿の件数・最後の1件が届いた時刻 — を運びます。
type ShowBoardThread struct {
	ID    viewmodel.ThreadID
	Title string

	// Languageはスレッドが書かれている言語で、行のバッジとして見せ、タイトルに
	// 宣言します。掲示板は言語で分けないため、1つの一覧に並ぶスレッドを見分けさせる
	// ものがこれです。
	Language viewmodel.ThreadLanguage

	PostsCount   int
	LastPostedAt time.Time
}

// ShowHeadingIDはこのページの主見出しのidです。コミュニティレイアウトが
// aria-labelledbyで <main> ランドマークをこれに向けるため、領域のアクセシブルな名前と、
// 目で見る訪問者が読む見出しが同じ文字列になります。
const ShowHeadingID = "thread-show-heading"

// ShowReplyHeadingIDは、スレッドの末尾の返信フォームを名付ける見出しのidです。
// フォームのセクションがaria-labelledbyでこれを指すため、その領域は見出しが見せるのと
// 同じ言葉で読み上げられます。
const ShowReplyHeadingID = "thread-show-reply-heading"

// postLabelIDは、指定されたレス番号の投稿を名付ける要素のidを返します。アンカーの
// 飛び先と同じ規則から導くため、名前とそれが名付ける投稿が離れていくことはありません。
func postLabelID(number int) string {
	return templates.PostElementID(number) + "-label"
}

// replyReferenceはレス番号を、本文がそれを書くのと同じ形で描画します。投稿へ
// 戻るリンクが、そこへ向かったリンクと同じ記法として読めるようにするためです。
func replyReference(number int) string {
	return ">>" + strconv.Itoa(number)
}

// ShowCenterはスレッドページの一覧カラムを描画します。このスレッドが立った掲示板と、
// そこに立っているスレッドです。ここではこれが補助のカラムです。このページはスレッドを
// 選ぶためではなく1つを読むために開かれるためです。読んでいるスレッドには現在地の印を
// 付け、一覧が訪問者のその中での位置を述べるようにします。
//
// 見出しは持ちません。このカラムは文書の中でスレッドより前に来るため、ページの <h1> より
// 前に見出しを置くとアウトラインの順序が崩れます。サイドバーが自身のグループを見出しでは
// なくラベルで名付けるのと同じ理由です。掲示板の名前はタイトルではなくリンクです。それが
// この一覧が何であるかを述べると同時に、その全体へ戻る道でもあるためです。
//
// スレッドを立てる導線は、掲示板自身のページと同じく一覧の上に立ちます。1つのスレッドを
// 読んでいる訪問者も、掲示板を眺めている訪問者と同じくらい別に述べたいことを持ちえます。
// これが無ければ、それを述べるにはまず /b/{slug} へ戻ることになります。
//
// 各行はスレッドの主言語を運びます。掲示板を言語で分けないため、1つの一覧が複数の言語の
// スレッドを持つからです。どの言語かはバッジが述べ、タイトルはそれを宣言します。これにより
// スクリーンリーダーは、タイトルをページの言語ではなく、それが書かれている言語の規則で
// 読み上げます。
templ ShowCenter(data ShowPageData) {
	<div class="flex flex-col gap-3">
		<a
			href={ templates.BoardPath(data.Board.Slug).SafeURL() }
			class="inline-flex min-h-6 min-w-6 items-center px-2 text-sm font-semibold hover:underline"
		>
			{ data.Board.Name }
		</a>
		<a
			href={ templates.BoardThreadsNewPath(data.Board.Slug).SafeURL() }
			class="btn w-full"
			data-variant="outline"
		>
			{ templates.T(ctx, "thread_show_new_thread_link") }
		</a>
		<ul class="flex flex-col">
			for _, thread := range data.Board.Threads {
				<li>
					<a
						href={ templates.ThreadPath(thread.ID).SafeURL() }
						class="block rounded-md px-2 py-2 hover:bg-accent aria-[current]:bg-accent"
						if templates.IsCurrentPath(ctx, templates.ThreadPath(thread.ID).String()) {
							aria-current="page"
						}
					>
						<span
							class="block text-sm"
							if thread.Language.Declared() {
								lang={ thread.Language.Tag }
							}
						>
							{ thread.Title }
						</span>
						<span class="mt-0.5 flex flex-wrap items-center gap-x-2 text-xs text-muted-foreground">
							@components.ThreadLanguageBadge(thread.Language)
							<span>{ templates.T(ctx, "posts_count", map[string]any{"Count": thread.PostsCount}) }</span>
							<time datetime={ templates.MachineDateTime(thread.LastPostedAt) }>
								{ templates.RelativeTime(ctx, thread.LastPostedAt) }
							</time>
						</span>
					</a>
				</li>
			}
		</ul>
	</div>
}

// ShowRightはスレッドページの読むためのカラムを描画します。スレッドの在り処を示す
// 経路、ページ見出しとしてのタイトル、そしてその中のすべての投稿をレス番号順に描きます。
// 訪問者がここへ読みに来たものがスレッドであるため、これがページの主カラムです。
//
// 各投稿はそれ自身がarticleであり、レス番号と作者で名付けられ、その番号を、>>Nと
// 共有された #p12が解決する先のidとして持ちます。番号は自分自身へのリンクでもあります。
// スレッド全体を1つのURLで配信するページから、訪問者が投稿1つのアドレスを取り出す
// 手立てがこれです。
//
// 管理者が非公開にした投稿は番号の並びの中に位置を保ち、占位として描かれます。占位が持つのは、
// 自分自身へのリンクであり続ける番号と、見えない場所へ移された旨を述べる1行です。本文・作者・
// 時刻・それへの返信は描きません。それを指す>>Nはすべてリンクのままであるため、辿った訪問者は
// 占位に着き、そこに何も無い理由を読みます。
//
// スレッドに対して働きかけることを許された訪問者には、スレッドへの操作を投稿数の下に、投稿への
// 操作をその投稿のヘッダーに差し出します。操作は、それが働きかける対象が読まれる場所に描かれ、
// 管理者は同じ場所で判断し実行します。どれも許されていない訪問者には何も示さず、ページは他の
// 誰にとってもと同じように読めます。占位は操作を持ちません。それが表す印はすでに付けられて
// いるためです。
//
// 各投稿は、ビューポートから遠く離れている間は描画を省けます。その固有サイズの代替値は、
// 1行の本文を持つデスクトップ表示の実測値に合わせます。ヘッダー・本文・境界線で
// 4.5625rem、返信フッターがあるときはさらに2remです。この2つを分けることで、深い
// #pNの飛び先より前に代替値の誤差が積み重なるのを防ぎます。印刷時は通常の描画へ戻し、
// 画面のビューポート外にあった投稿もすべて印刷文書へ渡します。
//
// ある投稿に答えた投稿は、その下に、それらの本文がそこへ辿り着くために書いたのと同じ
// >>Nの記法で並べます。会話を両方向に辿れるようにするためです。次の投稿が入るはずだった
// 場所に立つものは、スレッドと、それを読んでいる人によって変わります。その投稿を書く
// フォーム、アカウントを持たない訪問者にはそこへの導線、そしてこれ以上の投稿を受け付けない
// スレッドではその理由です。
//
// 見出しはスレッドの主言語を運びます。どの言語かは傍らのバッジが述べ、見出し自身が
// それを宣言します。投稿は宣言しません。別の言語での返信も受け付けるため、本文に
// スレッドの言語を付ければ、本文はそれが書かれていない言語を名乗ることになります。
templ ShowRight(data ShowPageData) {
	<div class="flex flex-col gap-6">
		<div class="flex flex-col gap-2">
			@components.Breadcrumb(data.Breadcrumb)
			<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
				<h1
					id={ ShowHeadingID }
					class="text-2xl font-bold tracking-tight"
					if data.Language.Declared() {
						lang={ data.Language.Tag }
					}
				>
					{ data.Title }
				</h1>
				@components.ThreadLanguageBadge(data.Language)
			</div>
			<p class="text-sm text-muted-foreground">
				{ templates.T(ctx, "posts_count", map[string]any{"Count": data.PostsCount}) }
			</p>
			if data.Moderation.Shown() {
				<div class="flex flex-wrap items-center gap-2">
					if data.Moderation.CanLockThread {
						if data.Lock.LockedByModerator() {
							<form
								action={ templates.ThreadLockPath(data.ThreadID).SafeURL() }
								method="POST"
								data-confirm={ templates.T(ctx, "thread_show_moderation_unlock_confirm") }
								onsubmit="if (!confirm(this.dataset.confirm)) { event.preventDefault(); return false; }"
							>
								<input type="hidden" name="_method" value="DELETE"/>
								<input type="hidden" name="csrf_token" value={ data.Moderation.CSRFToken }/>
								<button type="submit" class="btn" data-variant="outline" data-size="sm">
									{ templates.T(ctx, "thread_show_moderation_unlock_button") }
								</button>
							</form>
						} else {
							<a
								href={ templates.ThreadLockNewPath(data.ThreadID).SafeURL() }
								class="btn"
								data-variant="outline"
								data-size="sm"
							>
								{ templates.T(ctx, "thread_show_moderation_lock_link") }
							</a>
						}
					}
					if data.Moderation.CanUnpublishThread {
						<a
							href={ templates.ThreadUnpublicationNewPath(data.ThreadID).SafeURL() }
							class="btn"
							data-variant="outline"
							data-size="sm"
						>
							{ templates.T(ctx, "thread_show_moderation_unpublish_link") }
						</a>
					}
				</div>
			}
		</div>
		<ol class="flex flex-col gap-4">
			for _, post := range data.Posts {
				<li
					id={ templates.PostElementID(post.Number) }
					class={
						"scroll-mt-4",
						"[content-visibility:auto]",
						"print:[content-visibility:visible]",
						templ.KV("[contain-intrinsic-size:auto_6.5625rem]", post.HasReplies()),
						templ.KV("[contain-intrinsic-size:auto_4.5625rem]", !post.HasReplies()),
					}
				>
					<article aria-labelledby={ postLabelID(post.Number) } class="flex flex-col gap-2 border-b border-border pb-4">
						<header class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm text-muted-foreground">
							<span id={ postLabelID(post.Number) } class="flex flex-wrap items-baseline gap-x-2">
								<a
									href={ templates.PostAnchor(post.Number).SafeURL() }
									aria-label={ templates.T(ctx, "thread_show_post_link_label", map[string]any{"Number": post.Number}) }
									class="inline-flex min-h-6 min-w-6 items-center justify-center font-semibold text-foreground hover:underline"
								>
									{ strconv.Itoa(post.Number) }
								</a>
								if post.Unpublished {
									<span>{ templates.T(ctx, "thread_show_post_unpublished") }</span>
								} else if post.Author != "" {
									<span>{ "@" + post.Author }</span>
								} else {
									<span>{ templates.T(ctx, "thread_show_withdrawn_author") }</span>
								}
							</span>
							if !post.Unpublished {
								<time datetime={ templates.MachineDateTime(post.PostedAt) }>
									{ templates.RelativeTime(ctx, post.PostedAt) }
								</time>
							}
							if data.Moderation.CanUnpublishPost && !post.Unpublished {
								<a
									href={ templates.PostUnpublicationNewPath(data.ThreadID, post.Number).SafeURL() }
									aria-label={ templates.T(ctx, "thread_show_moderation_post_unpublish_link_label", map[string]any{"Number": post.Number}) }
									class="inline-flex min-h-6 items-center underline underline-offset-2"
								>
									{ templates.T(ctx, "thread_show_moderation_post_unpublish_link") }
								</a>
							}
						</header>
						if !post.Unpublished {
							@components.PostBody(post.Body)
						}
						if post.HasReplies() {
							<footer class="flex flex-wrap items-baseline gap-x-2 text-sm text-muted-foreground">
								<span>{ templates.T(ctx, "thread_show_replies_label") }</span>
								for _, number := range post.ReplyNumbers {
									<a
										href={ templates.PostAnchor(number).SafeURL() }
										class="inline-flex min-h-6 min-w-6 items-center underline underline-offset-2"
									>
										{ replyReference(number) }
									</a>
								}
							</footer>
						}
					</article>
				</li>
			}
		</ol>
		if data.Lock.Locked() {
			@components.ThreadLockNotice(data.LockNotice())
		} else if data.Reply.SignedIn {
			<section aria-labelledby={ ShowReplyHeadingID } class="flex flex-col gap-3">
				<h2 id={ ShowReplyHeadingID } class="text-lg font-semibold">
					{ templates.T(ctx, "thread_show_reply_heading") }
				</h2>
				@components.PostForm(data.Reply.Form)
			</section>
		} else {
			<div class="flex flex-col items-start gap-3">
				<p class="text-muted-foreground">{ templates.T(ctx, "thread_show_reply_sign_in_prompt") }</p>
				<a href={ templates.SignInPath().WithReturnTo(data.Reply.ReturnTo).SafeURL() } class="btn">
					{ templates.T(ctx, "thread_show_reply_sign_in_link") }
				</a>
			</div>
		}
	</div>
}
