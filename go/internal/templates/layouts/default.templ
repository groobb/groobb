package layouts

import (
	"github.com/a-h/templ"

	"github.com/groobb/groobb/go/internal/session"
	"github.com/groobb/groobb/go/internal/templates"
	"github.com/groobb/groobb/go/internal/templates/components"
	"github.com/groobb/groobb/go/internal/viewmodel"
)

// Defaultはページコンテンツを共通の <head>、フッター、ボディの外枠で包む
// 基本のHTMLレイアウトです。lang属性はi18nミドルウェアが解決したリクエストの
// ロケールを反映します。SignedInが付いたページはコンテンツの上に共通ヘッダーも
// 備え、認証の背後のどのページも同じ出口を持つようにします。
templ Default(meta viewmodel.PageMeta, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ templates.Locale(ctx) }>
		<head>
			@components.Head(meta)
		</head>
		<body class="flex min-h-screen flex-col">
			if meta.SignedIn {
				@components.Header()
			}
			<main class="flex flex-1 flex-col">
				@content
			</main>
			@components.Footer()
			@components.Flash(session.FlashFromContext(ctx))
		</body>
	</html>
}
