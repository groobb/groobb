package password_reset

import (
	"fmt"

	"github.com/a-h/templ"
)

// EnTextは英語のプレーンテキスト本文を描画します。JaTextと同様、整形済み
// 文字列からtempl.Rawで組み立て、改行をそのまま保ちます。
templ EnText(data Data) {
	@templ.Raw(fmt.Sprintf(
		"We received a request to reset the password for %s.\n\n"+
			"Open the link below to set a new password.\n\n"+
			"%s\n\n"+
			"This link is valid for %d %s.\n\n"+
			"If you did not request this email, please disregard it. Your password will not be changed.\n\n"+
			"Groobb\n",
		data.Email, data.ResetURL, data.ExpiresInHours, data.enHourUnit(),
	))
}
