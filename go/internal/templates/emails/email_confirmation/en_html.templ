package email_confirmation

import "github.com/groobb/groobb/go/internal/templates/emails/layouts"

// EnHTMLは英語のHTML本文を描画し、共有メールレイアウト (ドキュメントの外枠と
// Groobbフッターを供給する) で内容を包みます。
templ EnHTML(data Data) {
	@layouts.Default("en", "Confirmation code") {
		<p>Here is the confirmation code for { data.Email }.</p>
		<p>Enter the code below to confirm your email address.</p>
		<p style="font-size: 24px; font-weight: bold; letter-spacing: 4px;">{ data.Code }</p>
		<p>This code is valid for 15 minutes.</p>
		<p>If you did not request this email, please disregard it.</p>
	}
}
