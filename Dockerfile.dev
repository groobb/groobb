# syntax=docker/dockerfile:1.7
FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# Keep apt downloads for BuildKit cache mounts
# [Ja] BuildKit のキャッシュマウントで apt のダウンロード結果を保持する
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# --- System packages ---
# [Ja] システムパッケージ
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu

apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  bubblewrap                # Required by Codex for Linux sandboxing [Ja] Codex の Linux sandbox に必要
  build-essential
  ca-certificates           # Required for HTTPS connections [Ja] HTTPS 接続に必要
  curl
  fonts-noto-cjk            # CJK glyphs for playwright-cli screenshots [Ja] playwright-cli のスクショで CJK を描画 (豆腐回避)
  fzf                       # Used by coding agents [Ja] コーディングエージェントで使用
  git
  jq                        # Used by coding agents [Ja] コーディングエージェントで使用
  libssl-dev                # Required for SSL-related builds [Ja] SSL 関連のビルドに必要
  nano                      # Used by coding agents [Ja] コーディングエージェントで使用
  net-tools                 # Used by coding agents: netstat (network debugging) [Ja] コーディングエージェントで使用: netstat (ネットワークデバッグ用)
  procps                    # ps for playwright-cli kill-all [Ja] playwright-cli の kill-all 用 (ps を提供)
  psmisc                    # Used by coding agents: fuser (process identification) [Ja] コーディングエージェントで使用: fuser (プロセス特定用)
  ripgrep                   # Used by coding agents [Ja] コーディングエージェントで使用
  sqlite3                   # CLI for inspecting the dev SQLite database [Ja] 開発用 SQLite データベースの確認に使う CLI
  sudo
  tree                      # Used by coding agents [Ja] コーディングエージェントで使用
  unzip
  vim                       # Used by coding agents [Ja] コーディングエージェントで使用
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- mise (dev tool version manager) ---
# [Ja] mise (開発ツールバージョンマネージャー)
# Recommended config for Docker: use the shims approach.
# [Ja] Docker 環境向けの推奨設定: shims 方式を使用する。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Install Go, Node.js, and pnpm via mise
# [Ja] Go、Node.js、pnpm を mise 経由でインストール
RUN mise install go@1.26.3 && \
    mise install node@24.16.0 && \
    mise install pnpm@11.5.0

# Set global defaults
# [Ja] グローバルデフォルトを設定
RUN mise use --global go@1.26.3 && \
    mise use --global node@24.16.0 && \
    mise use --global pnpm@11.5.0

# --- hivemind ---
# [Ja] hivemind
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -o /tmp/hivemind.gz \
      https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- GitHub CLI ---
# [Ja] GitHub CLI
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && apt install -y gh

# --- User setup ---
# [Ja] ユーザー作成
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Go cache directories ---
# [Ja] Go キャッシュディレクトリ
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- mise data directory permissions ---
# [Ja] mise のデータディレクトリの権限設定
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

# --- 1Password CLI config directory ---
# The op-config named volume is mounted here. Docker copies ownership from the
# image only when the volume is created empty, so the directory has to exist
# with the developer user's ownership beforehand for `op` to write its config.
#
# [Ja] 名前付きボリューム op-config をここにマウントする。Docker がイメージ側の
# 所有権を引き継ぐのはボリュームが空で新規作成されたときだけのため、`op` が設定を
# 書き込めるよう開発者ユーザー所有のディレクトリを事前に用意しておく。
RUN install -d -o ${USER_ID} -g ${GROUP_ID} /home/${USERNAME}/.config && \
    install -d -o ${USER_ID} -g ${GROUP_ID} -m 0700 /home/${USERNAME}/.config/op

WORKDIR /workspace
USER ${USERNAME}

# --- Create .zshrc ---
# [Ja] .zshrc の作成
RUN touch ~/.zshrc

# --- mise shell setup ---
# [Ja] mise シェル設定
# Use the shims approach in Docker (already configured via PATH="/mise/shims:...").
# `mise activate` bypasses shims and prepends the direct paths of the global
# defaults to PATH, which breaks per-directory version switching. With the
# shims approach, activate is unnecessary.
#
# [Ja] Docker 環境では shims 方式を使用 (PATH="/mise/shims:..." で設定済み)。
# mise activate は shims をバイパスしてグローバルデフォルトの直接パスを PATH に
# 追加するため、ディレクトリごとのバージョン切り替えが効かなくなる。shims 方式では不要。
RUN mise reshim

# --- 1Password CLI ---
# [Ja] 1Password CLI
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
# [Ja] Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Codex ---
#
# [Ja] Codex
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# --- Go tools ---
# [Ja] Go ツール
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
# Pin GOBIN to GOPATH/bin so `go install` binaries land on PATH. The mise-managed
# `go` toolchain otherwise overrides GOBIN to its own bin ($GOROOT/bin =
# /mise/installs/go/<ver>/bin), which is not on PATH, so air would be installed
# yet unreachable (`air: not found` from `make dev`). An explicit GOBIN takes
# precedence over the mise default.
#
# [Ja] `go install` のバイナリを PATH 上の GOPATH/bin に置くため GOBIN を固定する。
# これが無いと mise 管理の `go` ツールチェインが GOBIN を自身の bin ($GOROOT/bin =
# /mise/installs/go/<ver>/bin) に上書きし、そこは PATH に無いため、air は
# インストールされても辿り着けない (`make dev` で `air: not found`)。GOBIN を明示すると
# mise のデフォルトより優先される。
ENV GOBIN="${GOPATH}/bin"
ENV PATH="${GOPATH}/bin:${PATH}"
RUN go install github.com/air-verse/air@latest

# --- golangci-lint ---
# [Ja] golangci-lint
#
# Fetch the release tarball directly and verify its SHA256 instead of
# piping the upstream install.sh from HEAD (the script itself is not
# pinned).
#
# [Ja] 公式 install.sh は HEAD の浮動 URL から取得され、スクリプト自体が固定されないため、
# リリース tarball を直接取得して SHA256 検証する。
ARG GOLANGCI_LINT_VERSION=v2.11.4
ARG GOLANGCI_LINT_SHA256=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
USER root
RUN GOLANGCI_LINT_DIR="golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-amd64" && \
    curl -fsSL -o /tmp/golangci-lint.tar.gz "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/${GOLANGCI_LINT_DIR}.tar.gz" && \
    echo "${GOLANGCI_LINT_SHA256}  /tmp/golangci-lint.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp --no-same-owner && \
    mv "/tmp/${GOLANGCI_LINT_DIR}/golangci-lint" /usr/local/bin/golangci-lint && \
    chmod +x /usr/local/bin/golangci-lint && \
    rm -rf "/tmp/golangci-lint.tar.gz" "/tmp/${GOLANGCI_LINT_DIR}"
USER ${USERNAME}

# --- Playwright CLI (browser verification) ---
# [Ja] Playwright CLI (ブラウザ動作確認)
#
# A single `npm install -g` covers the whole repository: mise resolves a global
# npm package through the Node version active in the working directory, and
# mise.toml pins only `go`, so /workspace and /workspace/go both fall back to
# the global default Node. Chromium and its system libraries come from
# --with-deps because the image ships neither; letting Playwright pick the
# packages keeps this in sync when its requirements change. The apt cache
# mounts keep the downloaded .deb files out of the layer, which matters here
# because docker-clean is disabled at the top of this file.
#
# [Ja] `npm install -g` は 1 回でリポジトリ全体をカバーする。mise は global npm パッケージを
# 作業ディレクトリで active な Node で解決するが、mise.toml が固定しているのは `go` だけ
# なので、/workspace も /workspace/go も global default の Node になる。Chromium 本体と
# system 依存はこのイメージにどちらも入っていないため --with-deps で入れる。パッケージの
# 選定を Playwright に任せることで、要求が変わったときも追従漏れが起きない。apt の
# キャッシュマウントは、ダウンロードした .deb をレイヤーに残さないために付けている
# (このファイル冒頭で docker-clean を無効化しているため)。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    npm install -g @playwright/cli@0.1.17 && \
    mise reshim && \
    playwright-cli install-browser chromium --with-deps

# --- Shell setup ---
# [Ja] シェル設定
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# --- Git config ---
# [Ja] Git 設定
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
