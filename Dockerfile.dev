# syntax=docker/dockerfile:1.7
FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# BuildKitのキャッシュマウントでaptのダウンロード結果を保持する
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# --- システムパッケージ ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu

apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  bubblewrap                # CodexのLinux sandboxに必要
  build-essential
  ca-certificates           # HTTPS接続に必要
  curl
  fonts-noto-cjk            # playwright-cliのスクショでCJKを描画 (豆腐回避)
  fzf                       # コーディングエージェントで使用
  git
  jq                        # コーディングエージェントで使用
  libssl-dev                # SSL関連のビルドに必要
  nano                      # コーディングエージェントで使用
  net-tools                 # コーディングエージェントで使用: netstat (ネットワークデバッグ用)
  procps                    # playwright-cliのkill-all用 (psを提供)
  psmisc                    # コーディングエージェントで使用: fuser (プロセス特定用)
  python3                   # Claude Codeのアドホックなスクリプト実行で使用
  ripgrep                   # コーディングエージェントで使用
  sqlite3                   # 開発用SQLiteデータベースの確認に使うCLI
  sudo
  tree                      # コーディングエージェントで使用
  unzip
  vim                       # コーディングエージェントで使用
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- mise (開発ツールバージョンマネージャー) ---
# Docker環境向けの推奨設定: shims方式を使用する。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Go、Node.js、pnpmをmise経由でインストール
RUN mise install go@1.26.3 && \
    mise install node@24.16.0 && \
    mise install pnpm@11.5.0

# グローバルデフォルトを設定
RUN mise use --global go@1.26.3 && \
    mise use --global node@24.16.0 && \
    mise use --global pnpm@11.5.0

# --- hivemind ---
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -o /tmp/hivemind.gz \
      https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- GitHub CLI ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && apt install -y gh

# --- ユーザー作成 ---
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Goキャッシュディレクトリ ---
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- miseのデータディレクトリの権限設定 ---
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

# --- 1Password CLIの設定ディレクトリ ---
# 名前付きボリュームop-configをここにマウントする。Dockerがイメージ側の
# 所有権を引き継ぐのはボリュームが空で新規作成されたときだけのため、`op` が設定を
# 書き込めるよう開発者ユーザー所有のディレクトリを事前に用意しておく。
RUN install -d -o ${USER_ID} -g ${GROUP_ID} /home/${USERNAME}/.config && \
    install -d -o ${USER_ID} -g ${GROUP_ID} -m 0700 /home/${USERNAME}/.config/op

WORKDIR /workspace
USER ${USERNAME}

# --- .zshrcの作成 ---
RUN touch ~/.zshrc

# --- miseシェル設定 ---
# Docker環境ではshims方式を使用 (PATH="/mise/shims:..." で設定済み)。
# mise activateはshimsをバイパスしてグローバルデフォルトの直接パスをPATHに
# 追加するため、ディレクトリごとのバージョン切り替えが効かなくなる。shims方式では不要。
RUN mise reshim

# --- 1Password CLI ---
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Codex ---
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# --- Goツール ---
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
# `go install` のバイナリをPATH上のGOPATH/binに置くためGOBINを固定する。
# これが無いとmise管理の `go` ツールチェインがGOBINを自身のbin ($GOROOT/bin =
# /mise/installs/go/<ver>/bin) に上書きし、そこはPATHに無いため、airは
# インストールされても辿り着けない (`make dev` で `air: not found`)。GOBINを明示すると
# miseのデフォルトより優先される。
ENV GOBIN="${GOPATH}/bin"
ENV PATH="${GOPATH}/bin:${PATH}"
RUN go install github.com/air-verse/air@latest

# --- golangci-lint ---
#
# 公式install.shはHEADの浮動URLから取得され、スクリプト自体が固定されないため、
# リリースtarballを直接取得してSHA256検証する。
ARG GOLANGCI_LINT_VERSION=v2.11.4
ARG GOLANGCI_LINT_SHA256=200c5b7503f67b59a6743ccf32133026c174e272b930ee79aa2aa6f37aca7ef1
USER root
RUN GOLANGCI_LINT_DIR="golangci-lint-${GOLANGCI_LINT_VERSION#v}-linux-amd64" && \
    curl -fsSL -o /tmp/golangci-lint.tar.gz "https://github.com/golangci/golangci-lint/releases/download/${GOLANGCI_LINT_VERSION}/${GOLANGCI_LINT_DIR}.tar.gz" && \
    echo "${GOLANGCI_LINT_SHA256}  /tmp/golangci-lint.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/golangci-lint.tar.gz -C /tmp --no-same-owner && \
    mv "/tmp/${GOLANGCI_LINT_DIR}/golangci-lint" /usr/local/bin/golangci-lint && \
    chmod +x /usr/local/bin/golangci-lint && \
    rm -rf "/tmp/golangci-lint.tar.gz" "/tmp/${GOLANGCI_LINT_DIR}"
USER ${USERNAME}

# --- Playwright CLI (ブラウザ動作確認) ---
#
# `npm install -g` は1回でリポジトリ全体をカバーする。miseはglobal npmパッケージを
# 作業ディレクトリでactiveなNodeで解決するが、mise.tomlが固定しているのは `go` だけ
# なので、/workspaceも/workspace/goもglobal defaultのNodeになる。Chromium本体と
# system依存はこのイメージにどちらも入っていないため --with-depsで入れる。パッケージの
# 選定をPlaywrightに任せることで、要求が変わったときも追従漏れが起きない。aptの
# キャッシュマウントは、ダウンロードした .debをレイヤーに残さないために付けている
# (このファイル冒頭でdocker-cleanを無効化しているため)。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    npm install -g @playwright/cli@0.1.17 && \
    mise reshim && \
    playwright-cli install-browser chromium --with-deps

# --- シェル設定 ---
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# --- Git設定 ---
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
