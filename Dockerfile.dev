# syntax=docker/dockerfile:1.7
FROM debian:trixie

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=developer

# Keep apt downloads for BuildKit cache mounts
# [Ja] BuildKit のキャッシュマウントで apt のダウンロード結果を保持する
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

# --- System packages ---
# [Ja] システムパッケージ
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    <<EOF
set -eu

apt update
apt dist-upgrade -yq

PACKAGES=$(cat <<'PKGLIST' | sed 's/#.*//'
  build-essential
  ca-certificates           # Required for HTTPS connections [Ja] HTTPS 接続に必要
  curl
  fzf                       # Used by Claude Code [Ja] Claude Code で使用
  git
  gnupg                     # Required for PostgreSQL GPG key and apt repository [Ja] PostgreSQL の GPG キーと apt リポジトリに必要
  jq                        # Used by Claude Code [Ja] Claude Code で使用
  libssl-dev                # Required for SSL-related builds [Ja] SSL 関連のビルドに必要
  lsb-release               # Required for PostgreSQL apt repository setup [Ja] PostgreSQL の apt リポジトリ設定に必要
  nano                      # Used by Claude Code [Ja] Claude Code で使用
  net-tools                 # Used by Claude Code: netstat (network debugging) [Ja] Claude Code で使用 netstat (ネットワークデバッグ用)
  psmisc                    # Used by Claude Code: fuser (process identification) [Ja] Claude Code で使用 fuser (プロセス特定用)
  ripgrep                   # Used by Claude Code [Ja] Claude Code で使用
  sudo
  tree                      # Used by Claude Code [Ja] Claude Code で使用
  unzip
  vim                       # Used by Claude Code [Ja] Claude Code で使用
  zsh
PKGLIST
)

apt install -y --no-install-recommends $PACKAGES
EOF

# --- PostgreSQL client ---
# [Ja] PostgreSQL クライアント
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list && \
    apt update && apt install -y libpq-dev postgresql-client-18

# --- mise (dev tool version manager) ---
# [Ja] mise (開発ツールバージョンマネージャー)
# Recommended config for Docker: use the shims approach.
# [Ja] Docker 環境向けの推奨設定: shims 方式を使用する。
ENV MISE_DATA_DIR="/mise"
ENV MISE_CONFIG_DIR="/mise"
ENV MISE_CACHE_DIR="/mise/cache"
ENV MISE_INSTALL_PATH="/usr/local/bin/mise"
ENV PATH="/mise/shims:${PATH}"
RUN curl -fsSL https://mise.run | sh

# Install Go, Node.js, and pnpm via mise
# [Ja] Go、Node.js、pnpm を mise 経由でインストール
RUN mise install go@1.26.3 && \
    mise install node@24.16.0 && \
    mise install pnpm@11.5.0

# Set global defaults
# [Ja] グローバルデフォルトを設定
RUN mise use --global go@1.26.3 && \
    mise use --global node@24.16.0 && \
    mise use --global pnpm@11.5.0

# --- dbmate ---
# [Ja] dbmate
ARG DBMATE_VERSION=v2.33.0
ARG DBMATE_SHA256=dfd4027141b6e4357158099bdfe6c02b286af70f8e49057937744cf80b38ea1c
RUN curl -fsSL -o /tmp/dbmate \
      https://github.com/amacneil/dbmate/releases/download/${DBMATE_VERSION}/dbmate-linux-amd64 && \
    echo "${DBMATE_SHA256}  /tmp/dbmate" | sha256sum -c - && \
    mv /tmp/dbmate /usr/local/bin/dbmate && \
    chmod +x /usr/local/bin/dbmate

# --- hivemind ---
# [Ja] hivemind
ARG HIVEMIND_VERSION=v1.1.0
ARG HIVEMIND_SHA256=809ca1c5fedbbfca8fdfb3a4b9bb9c41868b046f35f85a3e893ccf2583a3921a
RUN curl -fsSL -o /tmp/hivemind.gz \
      https://github.com/DarthSim/hivemind/releases/download/${HIVEMIND_VERSION}/hivemind-${HIVEMIND_VERSION}-linux-amd64.gz && \
    echo "${HIVEMIND_SHA256}  /tmp/hivemind.gz" | sha256sum -c - && \
    gunzip /tmp/hivemind.gz && \
    mv /tmp/hivemind /usr/local/bin/hivemind && \
    chmod +x /usr/local/bin/hivemind

# --- GitHub CLI ---
# [Ja] GitHub CLI
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p -m 755 /etc/apt/keyrings && \
    curl -fsSL -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg && \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt update && apt install -y gh

# --- User setup ---
# [Ja] ユーザー作成
RUN groupadd -g ${GROUP_ID} ${USERNAME} && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/zsh ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# --- Go cache directories ---
# [Ja] Go キャッシュディレクトリ
RUN mkdir -p /go/.cache/go-build /go/pkg && \
    chown -R ${USER_ID}:${GROUP_ID} /go

# --- mise data directory permissions ---
# [Ja] mise のデータディレクトリの権限設定
RUN chown -R ${USER_ID}:${GROUP_ID} /mise

WORKDIR /workspace
USER ${USERNAME}

# --- Create .zshrc ---
# [Ja] .zshrc の作成
RUN touch ~/.zshrc

# --- mise shell setup ---
# [Ja] mise シェル設定
# Use the shims approach in Docker (already configured via PATH="/mise/shims:...").
# `mise activate` bypasses shims and prepends the direct paths of the global
# defaults to PATH, which breaks per-directory version switching. With the
# shims approach, activate is unnecessary.
#
# [Ja] Docker 環境では shims 方式を使用 (PATH="/mise/shims:..." で設定済み)。
# mise activate は shims をバイパスしてグローバルデフォルトの直接パスを PATH に
# 追加するため、ディレクトリごとのバージョン切り替えが効かなくなる。shims 方式では不要。
RUN mise reshim

# --- 1Password CLI ---
# [Ja] 1Password CLI
COPY --from=1password/op:2 /usr/local/bin/op /usr/local/bin/op

# --- Claude Code ---
# [Ja] Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

# --- Go tools ---
# [Ja] Go ツール
ENV GOCACHE=/go/.cache/go-build
ENV GOMODCACHE=/go/pkg/mod
ENV GOPATH=/go
ENV PATH="${GOPATH}/bin:${PATH}"
# Build golangci-lint from source with this image's Go toolchain instead of
# downloading the prebuilt release binary. golangci-lint refuses to analyze a
# module whose go directive targets a newer Go than the one golangci-lint was
# built with, and the published binaries lag behind the latest Go. Building from
# source pins its language version to the go installed above (1.26.3), so lint
# works against the go 1.26.3 modules from the start.
#
# [Ja] golangci-lint を配布バイナリではなく本イメージの Go ツールチェーンで
# ソースからビルドする。golangci-lint は自身のビルドに使われた Go より新しい
# go ディレクティブを持つ module の解析を拒否し、配布バイナリは最新 Go に追従が
# 遅れる。ソースからビルドすると言語バージョンが上でインストールした Go (1.26.3)
# に固定されるため、最初から go 1.26.3 の module を lint できる。
ARG GOLANGCI_LINT_VERSION=v2.7.2
RUN go install github.com/sqlc-dev/sqlc/cmd/sqlc@v1.30.0 && \
    go install github.com/air-verse/air@latest && \
    go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}

# --- Shell setup ---
# [Ja] シェル設定
SHELL ["/bin/zsh", "-c"]
ENV SHELL=/bin/zsh

# --- Git config ---
# [Ja] Git 設定
RUN git config --global user.email "me@shimba.co" && \
    git config --global user.name "Koji Shimba"

EXPOSE 8080 3000

CMD ["/bin/zsh"]
